<Window x:Class="WindowsSetupAssistant.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WindowsSetupAssistant.App.ViewModels"
        xmlns:loc="clr-namespace:WindowsSetupAssistant.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{loc:Text Ui_AppTitle}"
        Icon="pack://application:,,,/WindowsSetupAssistant;component/Assets/AppIcon.ico"
        Height="780" Width="1200"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="16,14,16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== Thanh tiêu đề ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{loc:Text Ui_AppTitle}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{loc:Text Ui_AppSubtitle}"
                           Style="{StaticResource MutedText}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Text Ui_ProfileLabel}" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource MutedTextBrush}" />

                <ComboBox Width="200"
                          ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile}"
                          IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBoolean}}"
                          ToolTip="{loc:Text Ui_ProfileTooltip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Content="{loc:Text Ui_ProfileNew}" Command="{Binding NewProfileCommand}" Margin="6,0,0,0" ToolTip="{loc:Text Ui_ProfileNewTooltip}" />
                <Button Content="{loc:Text Ui_ProfileRename}" Command="{Binding RenameProfileCommand}" Margin="6,0,0,0" />
                <Button Content="{loc:Text Ui_ProfileDuplicate}" Command="{Binding DuplicateProfileCommand}" Margin="6,0,0,0" />
                <Button Content="{loc:Text Ui_ProfileDelete}" Command="{Binding DeleteProfileCommand}" Margin="6,0,0,0"
                        Style="{StaticResource DangerButton}" />

                <Border Width="1" Background="{DynamicResource AppBorderBrush}" Margin="12,2" />

                <TextBlock Text="{loc:Text Ui_LanguageLabel}" VerticalAlignment="Center"
                           Margin="0,0,8,0" Foreground="{DynamicResource MutedTextBrush}" />
                <ComboBox Width="130"
                          ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberPath="DisplayName" />
                <Border Width="1" Background="{DynamicResource AppBorderBrush}" Margin="12,2" />

                <Button Content="{Binding ThemeButtonText}" Command="{Binding ToggleThemeCommand}" />
            </StackPanel>
        </Grid>

        <!-- ==================== Cảnh báo thiếu WinGet ==================== -->
        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="14,12"
                CornerRadius="8"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="1.5"
                Visibility="{Binding ShowWingetWarning, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Text Ui_WarningWingetUnavailable}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningBrush}" />
                    <TextBlock Text="{Binding WingetWarning}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               Text="{loc:Text Ui_WarningWingetHelp}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{loc:Text Ui_BtnOpenStore}"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Command="{Binding OpenAppInstallerPageCommand}" />
            </Grid>
        </Border>

        <!-- ==================== Nội dung chính ==================== -->
        <TabControl Grid.Row="2">

            <!-- ~~~~~ Tab 1: Danh sách phần mềm ~~~~~ -->
            <TabItem Header="{loc:Text Ui_TabSoftwareList}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Thanh công cụ -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Width="240"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 ToolTip="{loc:Text Ui_FilterPlaceholder}" />

                        <ComboBox Grid.Column="1" Width="150" Margin="8,0,0,0"
                                  ItemsSource="{Binding CategoryFilters}"
                                  SelectedItem="{Binding CategoryFilter}"
                                  DisplayMemberPath="DisplayName" />

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="{loc:Text Ui_BtnSelectAll}" Command="{Binding SelectAllCommand}" />
                            <Button Content="{loc:Text Ui_BtnSelectNone}" Command="{Binding SelectNoneCommand}" Margin="6,0,0,0" />
                            <Button Content="{loc:Text Ui_BtnInvertSelection}" Command="{Binding InvertSelectionCommand}" Margin="6,0,0,0" />
                            <Button Content="{loc:Text Ui_BtnSelectNotInstalled}" Command="{Binding SelectNotInstalledCommand}" Margin="6,0,0,0" />

                            <Border Width="1" Background="{DynamicResource AppBorderBrush}" Margin="10,2" />

                            <Button Content="{loc:Text Ui_BtnAdd}" Command="{Binding AddPackageCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="{loc:Text Ui_BtnEdit}" Command="{Binding EditPackageCommand}" Margin="6,0,0,0" />
                            <Button Content="{loc:Text Ui_BtnDelete}" Command="{Binding DeletePackageCommand}" Margin="6,0,0,0"
                                    Style="{StaticResource DangerButton}" />
                            <Button Content="{loc:Text Ui_BtnMoveUp}" Command="{Binding MoveUpCommand}" Margin="6,0,0,0" Width="34" ToolTip="{loc:Text Ui_BtnMoveUpTooltip}" />
                            <Button Content="{loc:Text Ui_BtnMoveDown}" Command="{Binding MoveDownCommand}" Margin="4,0,0,0" Width="34" ToolTip="{loc:Text Ui_BtnMoveDownTooltip}" />
                        </StackPanel>
                    </Grid>

                    <!-- Bảng phần mềm -->
                    <DataGrid Grid.Row="1"
                              x:Name="PackagesGrid"
                              ItemsSource="{Binding PackagesView}"
                              SelectedItem="{Binding SelectedPackage}">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditPackageCommand}" />
                            <KeyBinding Key="Delete" Command="{Binding DeletePackageCommand}" />
                        </DataGrid.InputBindings>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Text Ui_ColumnInstall}" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding DataContext.IsNotInstalling, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  HorizontalAlignment="Center"
                                                  ToolTip="{loc:Text Ui_ColumnInstallTooltip}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{loc:Text Ui_ColumnName}" Binding="{Binding Name}" Width="2*" />

                            <DataGridTextColumn Header="{loc:Text Ui_ColumnPackageId}" Binding="{Binding PackageId}" Width="2*"
                                                FontFamily="Consolas" />

                            <DataGridTextColumn Header="{loc:Text Ui_ColumnCategory}" Binding="{Binding CategoryDisplayName}" Width="110" />

                            <DataGridTemplateColumn Header="{loc:Text Ui_ColumnStatus}" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding StatusBrushKey, Converter={StaticResource ResourceKeyToBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{loc:Text Ui_ColumnNotes}" Binding="{Binding Notes}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Thanh hành động dưới cùng -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{loc:Text Ui_BtnScanAndBackup}"
                                        Command="{Binding ScanAndBackupCommand}"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource PrimaryButton}"
                                        ToolTip="{loc:Text Ui_BtnScanAndBackupTooltip}" />
                                <Button Content="{loc:Text Ui_BtnCheckInstalled}"
                                        Command="{Binding RefreshInstalledCommand}"
                                        ToolTip="{loc:Text Ui_BtnCheckInstalledTooltip}" />

                                <Button Content="{loc:Text Ui_BtnRetryFailed}"
                                        Command="{Binding RetryFailedCommand}"
                                        Margin="8,0,0,0" />

                                <Button Content="{loc:Text Ui_BtnCancelInstall}"
                                        Command="{Binding CancelInstallCommand}"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource DangerButton}"
                                        Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}" />

                                <Button Content="{loc:Text Ui_BtnStartInstall}"
                                        Command="{Binding InstallSelectedCommand}"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryButton}" />
                            </StackPanel>

                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                  Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding CurrentPackageText}" Margin="0,0,0,6" />
                                    <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProgressText}"
                                           VerticalAlignment="Bottom"
                                           Margin="12,0,0,0"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ~~~~~ Tab 2: Tìm trên WinGet ~~~~~ -->
            <TabItem Header="{loc:Text Ui_TabSearchWinget}">
                <Grid DataContext="{Binding Search}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Text Ui_SearchPlaceholder}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1" Content="{loc:Text Ui_BtnSearch}" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SearchCommand}" />

                        <Button Grid.Column="2" Content="{loc:Text Ui_BtnClearSearch}" Margin="8,0,0,0"
                                Command="{Binding ClearCommand}" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                               Style="{StaticResource MutedText}" Margin="0,8,0,8" />

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Results}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Text Ui_ColumnName}" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="{loc:Text Ui_ColumnPackageId}" Binding="{Binding PackageId}" Width="2*"
                                                FontFamily="Consolas" />
                            <DataGridTextColumn Header="{loc:Text Ui_ColumnVersion}" Binding="{Binding Version}" Width="130" />
                            <DataGridTextColumn Header="{loc:Text Ui_ColumnSource}" Binding="{Binding Source}" Width="90" />
                            <DataGridTemplateColumn Header="" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button Content="{loc:Text Ui_BtnAddToProfile}"
                                                    Padding="10,4"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.Search.AddCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsAlreadyInList,
                                                                         Converter={StaticResource InverseBoolToVisibility}}" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Visibility="{Binding StatusText, Converter={StaticResource StringToVisibility}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ~~~~~ Tab 3: Kết quả cài đặt ~~~~~ -->
            <TabItem Header="{loc:Text Ui_TabInstallResults}">
                <DataGrid ItemsSource="{Binding Results}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Text Ui_ColumnName}" Binding="{Binding DisplayName}" Width="1.6*" />
                        <DataGridTextColumn Header="{loc:Text Ui_ColumnPackageId}" Binding="{Binding PackageId}" Width="1.6*"
                                            FontFamily="Consolas" />
                        <DataGridTemplateColumn Header="{loc:Text Ui_ColumnResultOutcome}" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Outcome, Converter={StaticResource InstallOutcome}}"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Outcome, Converter={StaticResource InstallOutcomeToBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Text Ui_ColumnResultExitCode}"
                                            Binding="{Binding ExitCode, Converter={StaticResource ExitCode}}"
                                            Width="160" FontFamily="Consolas" />
                        <DataGridTextColumn Header="{loc:Text Ui_ColumnResultDuration}"
                                            Binding="{Binding Duration, Converter={StaticResource Duration}}"
                                            Width="110" />
                        <DataGridTextColumn Header="{loc:Text Ui_ColumnResultMessage}" Binding="{Binding Message}" Width="2.4*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ~~~~~ Tab 4: Nhật ký ~~~~~ -->
            <TabItem Header="{loc:Text Ui_TabLogs}">
                <Grid DataContext="{Binding Logs}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="{loc:Text Ui_BtnClearLogs}" Command="{Binding ClearCommand}" />
                        <Button Content="{loc:Text Ui_BtnCopyAllLogs}" Command="{Binding CopyCommand}" Margin="8,0,0,0" />
                        <Button Content="{loc:Text Ui_BtnOpenLogFolder}" Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0" />
                        <CheckBox Content="{loc:Text Ui_ChkAutoScroll}" IsChecked="{Binding AutoScroll}" Margin="16,0,0,0" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="LogGrid" ItemsSource="{Binding Entries}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Text Ui_ColumnLogTime}"
                                                Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                                Width="90" FontFamily="Consolas" />
                            <DataGridTemplateColumn Header="{loc:Text Ui_ColumnLogLevel}" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Level}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Text Ui_ColumnLogMessage}" Binding="{Binding Message}" Width="2*" />
                            <DataGridTextColumn Header="{loc:Text Ui_ColumnLogCommand}" Binding="{Binding Command}" Width="2*"
                                                FontFamily="Consolas" />
                            <DataGridTextColumn Header="{loc:Text Ui_ColumnResultExitCode}"
                                                Binding="{Binding ExitCode, Converter={StaticResource ExitCode}}"
                                                Width="150" FontFamily="Consolas" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="{Binding LogFileDescription}"
                               Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ==================== Thanh trạng thái ==================== -->
        <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,8,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource MutedText}"
                           Text="{Binding DataFilePath, StringFormat='Dữ liệu: {0}'}"
                           ToolTip="{Binding DataFilePath}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PrivilegeText}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="{loc:Text Ui_BtnRestartAsAdmin}" Command="{Binding RestartAsAdminCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="{loc:Text Ui_BtnOpenDataFolder}" Command="{Binding OpenDataFolderCommand}" />
                    <Button Content="{loc:Text Ui_BtnImportJson}" Command="{Binding ImportCommand}" Margin="6,0,0,0" />
                    <Button Content="{loc:Text Ui_BtnExportAll}" Command="{Binding ExportCommand}" Margin="6,0,0,0" />
                    <Button Content="{loc:Text Ui_BtnExportCurrent}" Command="{Binding ExportProfileCommand}" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
