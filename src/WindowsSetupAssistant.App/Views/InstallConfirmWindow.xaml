<Window x:Class="WindowsSetupAssistant.App.Views.InstallConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WindowsSetupAssistant.App.ViewModels"
        xmlns:loc="clr-namespace:WindowsSetupAssistant.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:InstallConfirmViewModel}"
        Title="{loc:Text Ui_ConfirmTitle}"
        Width="620" Height="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Headline}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ListBox ItemsSource="{Binding Packages}" BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PackageId}" FontFamily="Consolas"
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{Binding StatusText}"
                                       Foreground="{Binding StatusBrushKey, Converter={StaticResource ResourceKeyToBrush}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{loc:Text Ui_ConfirmExistingLabel}" Style="{StaticResource SectionTitleText}" />
                <RadioButton Content="{loc:Text Ui_ConfirmActionSkip}"
                             IsChecked="{Binding SkipExisting}" />
                <RadioButton Content="{loc:Text Ui_ConfirmActionUpgrade}"
                             IsChecked="{Binding UpgradeExisting}" />

                <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                           Text="{loc:Text Ui_ConfirmNote}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Text Ui_BtnCancel}" IsCancel="True" MinWidth="110" />
            <Button Content="{loc:Text Ui_BtnStartInstall}" Click="OnConfirmClick" IsDefault="True" MinWidth="150" Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
