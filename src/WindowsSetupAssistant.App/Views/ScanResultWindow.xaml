<Window x:Class="WindowsSetupAssistant.App.Views.ScanResultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Kết quả quét phần mềm" Width="980" Height="760" MinWidth="820" MinHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="150"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="130"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16"><TextBlock Text="{Binding Headline}" Style="{StaticResource PageTitleText}"/><TextBlock Text="Chọn phần mềm muốn mang sang máy mới. Mục cài tay chỉ được ghi chú, không tự động cài." Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,6"><TextBlock Text="{Binding AutomaticHeader}" Style="{StaticResource SectionTitleText}"/><TextBlock Text="Có thể cài lại bằng WinGet" Style="{StaticResource MutedText}" Margin="12,3,0,0"/></DockPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding AutomaticEntries}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridCheckBoxColumn Header="Giữ" Width="55" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Tên phần mềm" Width="2*" Binding="{Binding Name}" IsReadOnly="True"/><DataGridTextColumn Header="WinGet Package Id" Width="2*" Binding="{Binding RawId}" IsReadOnly="True"/><DataGridTextColumn Header="Phiên bản" Width="130" Binding="{Binding Version}" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
        <DockPanel Grid.Row="3" Margin="0,16,0,6"><TextBlock Text="{Binding ManualHeader}" Style="{StaticResource SectionTitleText}"/><TextBlock Text="Cần cài thủ công sau khi cài Windows" Style="{StaticResource MutedText}" Margin="12,3,0,0"/></DockPanel>
        <DataGrid Grid.Row="4" ItemsSource="{Binding ManualEntries}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridCheckBoxColumn Header="Ghi" Width="55" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Tên phần mềm" Width="2*" Binding="{Binding Name}" IsReadOnly="True"/><DataGridTextColumn Header="Mã định danh" Width="2*" Binding="{Binding RawId}" IsReadOnly="True"/><DataGridTextColumn Header="Phiên bản" Width="130" Binding="{Binding Version}" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
        <CheckBox Grid.Row="5" Content="{Binding SystemComponentLabel}" IsChecked="{Binding ShowSystemComponents}" Margin="0,14,0,0"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Huỷ" IsCancel="True" MinWidth="110"/><Button Content="Lưu bản sao lưu" IsDefault="True" MinWidth="160" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Click="OnSaveClick"/></StackPanel>
    </Grid>
</Window>
