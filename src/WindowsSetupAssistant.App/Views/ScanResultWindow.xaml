<Window x:Class="WindowsSetupAssistant.App.Views.ScanResultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WindowsSetupAssistant.App.Localization" Title="{loc:Text Ui_ScanResultTitle}" Width="980" Height="760" MinWidth="820" MinHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="150"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="130"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16"><TextBlock Text="{Binding Headline}" Style="{StaticResource PageTitleText}"/><TextBlock Text="{loc:Text Ui_ScanResultSubtitle}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,6"><TextBlock Text="{Binding AutomaticHeader}" Style="{StaticResource SectionTitleText}"/><TextBlock Text="{loc:Text Ui_ScanGroupWinget}" Style="{StaticResource MutedText}" Margin="12,3,0,0"/></DockPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding AutomaticEntries}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridCheckBoxColumn Header="{loc:Text Ui_ColumnKeep}" Width="55" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="{loc:Text Ui_ColumnName}" Width="2*" Binding="{Binding Name}" IsReadOnly="True"/><DataGridTextColumn Header="{loc:Text Ui_ColumnPackageId}" Width="2*" Binding="{Binding RawId}" IsReadOnly="True"/><DataGridTextColumn Header="{loc:Text Ui_ColumnVersion}" Width="130" Binding="{Binding Version}" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
        <DockPanel Grid.Row="3" Margin="0,16,0,6"><TextBlock Text="{Binding ManualHeader}" Style="{StaticResource SectionTitleText}"/><TextBlock Text="{loc:Text Ui_ScanGroupManual}" Style="{StaticResource MutedText}" Margin="12,3,0,0"/></DockPanel>
        <DataGrid Grid.Row="4" ItemsSource="{Binding ManualEntries}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridCheckBoxColumn Header="{loc:Text Ui_ColumnRecord}" Width="55" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="{loc:Text Ui_ColumnName}" Width="2*" Binding="{Binding Name}" IsReadOnly="True"/><DataGridTextColumn Header="{loc:Text Ui_ColumnIdentifier}" Width="2*" Binding="{Binding RawId}" IsReadOnly="True"/><DataGridTextColumn Header="{loc:Text Ui_ColumnVersion}" Width="130" Binding="{Binding Version}" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
        <CheckBox Grid.Row="5" Content="{Binding SystemComponentLabel}" IsChecked="{Binding ShowSystemComponents}" Margin="0,14,0,0"/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="{loc:Text Ui_BtnCancel}" IsCancel="True" MinWidth="110"/><Button Content="{loc:Text Ui_BtnSaveBackup}" IsDefault="True" MinWidth="160" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Click="OnSaveClick"/></StackPanel>
    </Grid>
</Window>
