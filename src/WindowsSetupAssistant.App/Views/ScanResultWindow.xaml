<Window x:Class="WindowsSetupAssistant.App.Views.ScanResultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Kết quả quét phần mềm" Width="900" Height="700" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{Binding Headline}" FontSize="22"/><TextBlock Text="Chọn phần mềm cần mang sang máy mới." Margin="0,4,0,12"/></StackPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding AutomaticEntries}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Giữ" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Tên" Binding="{Binding Name}"/><DataGridTextColumn Header="Package Id" Binding="{Binding RawId}"/><DataGridTextColumn Header="Phiên bản" Binding="{Binding Version}"/></DataGrid.Columns></DataGrid>
    <DataGrid Grid.Row="2" ItemsSource="{Binding ManualEntries}" AutoGenerateColumns="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Ghi" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/><DataGridTextColumn Header="Tên" Binding="{Binding Name}"/><DataGridTextColumn Header="Mã định danh" Binding="{Binding RawId}"/><DataGridTextColumn Header="Phiên bản" Binding="{Binding Version}"/></DataGrid.Columns></DataGrid>
    <DataGrid Grid.Row="3" ItemsSource="{Binding SystemEntries}" AutoGenerateColumns="False" Visibility="{Binding ShowSystemComponents, Converter={StaticResource BoolToVisibility}}"><DataGrid.Columns><DataGridTextColumn Header="Tên hệ thống" Binding="{Binding Name}"/><DataGridTextColumn Header="Mã định danh" Binding="{Binding RawId}"/><DataGridTextColumn Header="Phiên bản" Binding="{Binding Version}"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><CheckBox Content="{Binding SystemComponentLabel}" IsChecked="{Binding ShowSystemComponents}" Margin="0,0,20,0"/><Button Content="Huỷ" IsCancel="True" Width="100"/><Button Content="Lưu bản sao lưu" IsDefault="True" Width="140" Margin="8,0,0,0" Click="OnSaveClick"/></StackPanel>
  </Grid>
</Window>
