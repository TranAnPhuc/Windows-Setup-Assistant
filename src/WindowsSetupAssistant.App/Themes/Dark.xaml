<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Bảng màu giao diện Tối - dùng chung bộ khoá với Light.xaml. -->

    <Color x:Key="WindowBackgroundColor">#12151A</Color>
    <Color x:Key="SurfaceColor">#1B1F26</Color>
    <Color x:Key="AccentColor">#3B82F6</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#232830" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#333A45" />

    <SolidColorBrush x:Key="TextBrush" Color="#E9ECF1" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#98A2B0" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5A9BFF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2C6ED5" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E2C46" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />

    <SolidColorBrush x:Key="HoverBrush" Color="#262C35" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2A3546" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#5C6674" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#23272E" />

</ResourceDictionary>
