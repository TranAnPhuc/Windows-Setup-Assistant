<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Bảng màu giao diện Sáng.
        Dark.xaml khai báo ĐÚNG các khoá này với giá trị khác,
        nhờ vậy ThemeManager chỉ cần tráo từ điển là toàn bộ app đổi màu.
    -->

    <Color x:Key="WindowBackgroundColor">#F4F6F9</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="AccentColor">#2563EB</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EDF0F5" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#DCE1E8" />

    <SolidColorBrush x:Key="TextBrush" Color="#161A20" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5D6874" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4FD8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1A44BB" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E4EBFD" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />

    <SolidColorBrush x:Key="HoverBrush" Color="#EBF0F7" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#DBE6FB" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#A2AAB5" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#E9ECF1" />

</ResourceDictionary>
